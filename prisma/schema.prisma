// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  items           Json     // Will store CartItem array
  contact         Json     // Will store contact information
  totalPrice      Float
  status          String   @default("pending")
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  role         String    @default("manager") // admin | manager
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  consentAt DateTime?
} 
// Таблица совместимости (двигатели), заполняется в админке; публикуется тумблером Setting["compatibility"] = "on".
model Vehicle {
  id        String   @id @default(cuid())
  brand     String
  model     String
  engine    String
  years     String?
  note      String?
  createdAt DateTime @default(now())
}

// Журнал входов в админку. ok=true — сессия (id зашит в cookie, можно завершить), ok=false — неудачная попытка.
model AdminLogin {
  id         String    @id @default(cuid())
  login      String
  ok         Boolean
  ip         String
  userAgent  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  lastIp     String?
  revokedAt  DateTime?

  @@index([login, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  // Реальная дата правки: sitemap берёт её как lastmod для каталога и товаров.
  updatedAt DateTime @default(now()) @updatedAt
}
