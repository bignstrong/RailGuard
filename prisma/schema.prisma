// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  items           Json     // Will store CartItem array
  contact         Json     // Will store contact information
  totalPrice      Float
  status          String   @default("pending")
  note            String?
  // Атрибуция (lib/attribution.ts): канал последнего значимого перехода, {ft, lt, ymClientId}, устройство.
  channel         String?
  attribution     Json?
  device          String?
  // Покупатель (lib/customers.ts): совпали и телефон, и email — заказы под одним покупателем.
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

// Покупатель — пара «телефон + email» из заказов. Заготовка под личный кабинет; входа пока нет.
// Без заказов не живёт: удаляется вместе с последним заказом.
model Customer {
  id        String   @id @default(cuid())
  phone     String // 10 цифр без +7, как в Order.contact
  email     String // в нижнем регистре
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([phone, email])
}

model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  role         String    @default("manager") // admin | manager
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  consentAt DateTime?
} 
// Таблица совместимости (двигатели), заполняется в админке; публикуется тумблером Setting["compatibility"] = "on".
model Vehicle {
  id        String   @id @default(cuid())
  brand     String
  model     String
  engine    String
  years     String?
  note      String?
  createdAt DateTime @default(now())
}

// Журнал входов в админку. ok=true — сессия (id зашит в cookie, можно завершить), ok=false — неудачная попытка.
model AdminLogin {
  id         String    @id @default(cuid())
  login      String
  ok         Boolean
  ip         String
  userAgent  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  lastIp     String?
  revokedAt  DateTime?

  @@index([login, createdAt])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  // Реальная дата правки: sitemap берёт её как lastmod для каталога и товаров.
  updatedAt DateTime @default(now()) @updatedAt
}

// Счётчики воронки по дням (МСК): visit / view / add / cart в разрезе канала и товара. Без cookie и IP.
model DailyStat {
  day     String // YYYY-MM-DD
  event   String
  channel String
  product String @default("")
  count   Int    @default(0)

  @@id([day, event, channel, product])
}
