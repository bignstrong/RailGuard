# Database
POSTGRES_USER=railguard
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=railguard
DATABASE_URL=postgresql://railguard:change_me_strong_password@postgres:5432/railguard?schema=public

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://railguard.ru
NODE_ENV=production

# Гео: страна берётся из заголовка X-Country (nginx geoip2). Для локальной проверки GA можно задать вручную, например US.
# GEO_DEFAULT_COUNTRY=

# Уведомления о заказах по email (SMTP Яндекс 360). Не задано — заказ сохраняется, письмо пропускается.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@railguard.ru
SMTP_PASS=пароль_приложения_из_Яндекс_ID
SMTP_FROM=info@railguard.ru
ORDER_NOTIFY_TO=info@railguard.ru

# Админка. Живёт на секретном пути ADMIN_PATH (прямой /admin всегда 404). Значения генерирует: node scripts/admin-setup.mjs
ADMIN_PATH=/change-me-panel
ADMIN_LOGIN=owner
# Хеш пароля владельца нужен только для первого входа: после него пользователь живёт в БД
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Необязательно: доступ к /admin только с этих IP (через запятую)
# ADMIN_ALLOWED_IPS=
