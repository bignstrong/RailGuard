# Database
POSTGRES_USER=railguard
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=railguard
DATABASE_URL=postgresql://railguard:change_me_strong_password@postgres:5432/railguard?schema=public

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://railguard.ru
NODE_ENV=production

# Гео: страна берётся из заголовка X-Country (nginx geoip2). Для локальной проверки GA можно задать вручную, например US.
# GEO_DEFAULT_COUNTRY=

# Уведомления о заказах по email. Почта домена на SpaceWeb (MX spaceweb.ru), пароль ящика — в панели cp.sweb.ru → Почта. Не задано — заказ сохраняется, письмо пропускается.
SMTP_HOST=smtp.spaceweb.ru
SMTP_PORT=465
SMTP_USER=order@railguard.ru
SMTP_PASS=пароль_ящика_order@railguard.ru
SMTP_FROM="RailGuard <order@railguard.ru>"
# Запасной получатель, если в админке «Сайт → Уведомления о заказах» пусто
ORDER_NOTIFY_TO=info@railguard.ru

# Админка. Живёт на секретном пути ADMIN_PATH (прямой /admin всегда 404). Значения генерирует: node scripts/admin-setup.mjs
ADMIN_PATH=/change-me-panel
ADMIN_LOGIN=owner
# Хеш пароля владельца нужен только для первого входа: после него пользователь живёт в БД
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Необязательно: доступ к /admin только с этих IP (через запятую)
# ADMIN_ALLOWED_IPS=

# Бэкап БД (backup.sh, cron 02:30): дамп в Telegram; если TG с сервера недоступен или не задан — письмом на ORDER_NOTIFY_TO.
# BACKUP_TG_TOKEN=123456:ABC...
# BACKUP_TG_CHAT=123456789
# Если api.telegram.org с сервера недоступен — прокси для curl: socks5h://user:pass@host:1080 или http://host:3128
# BACKUP_TG_PROXY=

# IndexNow: ключ (8–128 символов a-z0-9-) для отправки обновлений в Яндекс/Bing. После деплоя: node scripts/indexnow.mjs
# INDEXNOW_KEY=
